# Copie este arquivo para ".env" e preencha com os seus valores.

# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# Application ID (Developer Portal > General Information)
DISCORD_APPLICATION_ID=

# Cargo que pode usar os comandos administrativos
DISCORD_ROLE_ID=1542326621745447063

# Endereço do site publicado
SITE_URL=https://zero-order.lovable.app
